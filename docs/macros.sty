\newcommand{\angvel}[2]{{}^\mathcal{#1}\boldsymbol{\omega}^\mathcal{#2}}
\newcommand{\pd}{\partial}
\newcommand{\norm}[1]{\| #1 \|}
\newcommand{\rotmat}[2]{{}^\mathcal{#1}R_\mathcal{#2}}
\newcommand{\fv}[2]{{}^\mathcal{#1}\mathbf{#2}}
