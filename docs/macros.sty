% KaTeX draws \tilde as a literal `~`. mdbook's markdown pass runs after the katex
% preprocessor, so two tildes in one paragraph get read as strikethrough and <del>
% is injected into the math. \widetilde is drawn as an SVG path, carrying no `~`.
\renewcommand{\tilde}[1]{\widetilde{#1}}
\newcommand{\tbf}[1]{\widetilde{\mathbf{#1}}}
